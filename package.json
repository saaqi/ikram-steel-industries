{
  "name": "ikram-steel-industries",
  "description": "An HTML5 single page website template. This is a single page website template for a Production Company Introduction. The website has a fully responsive header area, products section, mission statement, contact area with WhatsApp, Google maps and call links, gallery section, and footer section. This website template can be used by any steel melter company to showcase their products, services, and company information.",
  "private": true,
  "version": "2.1.3",
  "type": "module",
  "engines": {
    "node": ">=26.13.1"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
  "scripts": {
    "postinstall": "git switch dev || git switch -c dev",
    "pull": "git switch main && git pull origin main && git switch dev && git pull origin dev",
    "build": "vite build",
    "build-bootstrap": "sass --no-source-map ./src/styles/bs-dynamic.scss ./src/styles/bootstrap.css",
    "check": "svelte-kit sync && svelte-check && pnpm run lint",
    "check:watch": "svelte-kit sync && svelte-check --watch",
    "dev": "vite dev",
    "upload": "git checkout main && git pull && git merge dev && git push && git checkout dev",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "preview": "pnpm run build && wrangler dev",
    "prepare": "svelte-kit sync || echo ''",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types ./src/worker-configuration.d.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fullhuman/postcss-purgecss": "^9.1.0",
    "@sveltejs/adapter-cloudflare": "^9.0.0",
    "@sveltejs/enhanced-img": "^1.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "autoprefixer": "^10.7.0",
    "cssnano": "^9.9.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "sass-embedded": "^1.108.2",
    "super-sitemap": "^2.0.6",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "terser": "^5.51.4",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "wrangler": "^4.166.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "bootstrap": "^5.3.9",
    "boxicons": "^2.1.4",
    "fslightbox": "^3.8.0"
  },
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*",
    "#components": "./src/components/index.ts",
    "#components/*": "./src/components/*",
    "#assets/*": "./src/assets/*",
    "#styles/*": "./src/styles/*"
  }
}
