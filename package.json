{
  "name": "ikram-steel-industries",
  "description": "An HTML5 single page website template. This is a single page website template for a Production Company Introduction. The website has a fully responsive header area, products section, mission statement, contact area with WhatsApp, Google maps and call links, gallery section, and footer section. This website template can be used by any steel melter company to showcase their products, services, and company information.",
  "private": true,
  "version": "2.1.1",
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "scripts": {
    "build": "rimraf .svelte-kit/cloudflare && vite build --emptyOutDir",
    "build-bootstrap": "sass --no-source-map ./src/styles/bs-dynamic.scss ./src/styles/bootstrap.css",
    "check": "svelte-kit sync && svelte-check && pnpm run lint",
    "check:watch": "svelte-kit sync && svelte-check --watch",
    "dev": "vite dev",
    "upload": "git checkout main && git pull && git merge dev && git push && git checkout dev",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "preview": "pnpm run build && wrangler pages dev",
    "prepare": "svelte-kit sync || echo ''",
    "deploy": "pnpm run build && wrangler pages deploy"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@fullhuman/postcss-purgecss": "^9.1.0",
    "@sveltejs/adapter-cloudflare": "^9.0.0",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/load-config": "^0.2.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "autoprefixer": "^10.7.0",
    "cssnano": "^9.9.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "rimraf": "^6.1.4",
    "sass-embedded": "^1.108.2",
    "super-sitemap": "^2.0.6",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "terser": "^5.51.4",
    "vite": "^8.3.8",
    "wrangler": "^4.166.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@sveltejs/enhanced-img": "^1.0.1",
    "bootstrap": "^5.3.9",
    "boxicons": "^2.1.4",
    "fslightbox": "^3.8.0"
  },
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*",
    "#components": "./src/components/index.ts",
    "#components/*": "./src/components/*",
    "#assets/*": "./src/assets/*",
    "#styles/*": "./src/styles/*"
  }
}
